# OpenAI 或兼容 OpenAI Chat Completions 的服务
LLM_API_KEY=replace_me
LLM_MODEL=gpt-4.1-mini
# 兼容服务才需要填写；官方 OpenAI 留空
LLM_BASE_URL=
# 工具参数 JSON 解析失败后的额外决策重试次数
LLM_DECISION_RETRIES=2
# Embedding 可使用与 LLM 不同的 OpenAI 兼容服务；留空时回退到 LLM 配置
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Voyage AI 已验证示例（启用时替换上面的 Base URL 和模型）：
# EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# EMBEDDING_MODEL=voyage-4
# retrieve_knowledge Tool 使用的本地 Chroma 配置
KNOWLEDGE_DB_PATH=.knowledge/chroma
KNOWLEDGE_COLLECTION=competitor_knowledge
# 报告成功后自动评估并增量入库；Demo 始终不入库
KNOWLEDGE_AUTO_INGEST=true
KNOWLEDGE_MIN_CONTENT_CHARS=200
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50

# 搜索 API：https://tavily.com/
TAVILY_API_KEY=replace_me

MAX_ROUNDS=12
# 每轮决策使用的精简 Context
CONTEXT_CHAR_BUDGET=14000
# 仅在最终报告生成时使用的丰富 Context
REPORT_CONTEXT_CHAR_BUDGET=70000
HTTP_TIMEOUT=20
